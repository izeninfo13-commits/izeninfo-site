# IZENINFO – configuration Apache (OVH)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddType font/woff2 .woff2
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On
# Forcer HTTPS et le domaine sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://izeninfo.fr%{REQUEST_URI} [L,R=301]
# Anciennes adresses (ancien site) encore visitées et connues de Google
RewriteRule ^marseille/?$ https://izeninfo.fr/creation-site-internet-marseille/ [L,R=301]
RewriteRule ^(bayonne|legal|mentions-legales)/?$ https://izeninfo.fr/ [L,R=301]
RewriteRule ^(contact|services|tarifs|realisations)/?$ https://izeninfo.fr/#$1 [L,R=301,NE]
RewriteRule ^portfolio/?$ https://izeninfo.fr/#realisations [L,R=301,NE]
# Page d'accueil en double
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://izeninfo.fr/ [L,R=301]
# Dossiers sans barre finale : redirection propre (sans :443)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://izeninfo.fr/$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
<FilesMatch "\.(webp|jpg|png|svg|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
<FilesMatch "^i18n\.json$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
<FilesMatch "\.(xml|txt)$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript image/svg+xml application/json
</IfModule>
